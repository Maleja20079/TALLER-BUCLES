Algoritmo cantidadNum
	definir num, num1 , contador Como Entero
	
	escribir "Ingrese un número"
	leer num
	contador= 0
	num1 = 1
	
	mientras (contador<num -1 ) Hacer
		escribir num1 " ", " "
		num1 = num1 + 2
		contador = contador + 1
		
	FinMientras
	
	imprimir (num1)
	
	
	
FinAlgoritmo
